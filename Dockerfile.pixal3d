# Pixal3D — pixel-aligned image-to-3D on the TRELLIS.2 backbone.
# Same native stack as Dockerfile.trellis2 (nvdiffrast / nvdiffrec / CuMesh /
# FlexGEMM / o-voxel), plus NATTEN for the NAF feature upsampler that the
# pixel-aligned conditioner needs. The rest of the delta is the Pixal3D fork
# (ElasticSLatFlowModel with image_attn_mode=proj) plus MoGe.
# Tags: ghcr.io/satanexist/paradox_worker:pixal3d-sha-<short>

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/lib64 \
    MAX_JOBS=2 \
    PYOPENGL_PLATFORM=egl \
    PYTHONPATH=/app:/app/Pixal3D:/app/TRELLIS.2 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    ATTN_BACKEND=sdpa \
    SPARSE_ATTN_BACKEND=xformers \
    SPARSE_CONV_BACKEND=flex_gemm \
    HF_HOME=/runpod-volume/huggingface_cache \
    FLEX_GEMM_AUTOTUNE_CACHE_PATH=/runpod-volume/flex_gemm_autotune.json \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9+PTX"

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
      torch==2.6.0 torchvision==0.21.0 \
      --index-url https://download.pytorch.org/whl/cu124

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    pkg-config \
    libjpeg-dev \
    libpng-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libglvnd0 \
    libgl1 \
    libglx0 \
    libegl1 \
    libgles2 \
    libglvnd-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# huggingface_hub must stay below 1.0: transformers refuses to import with the
# 1.x line, and plain `huggingface_hub` now resolves there.
RUN pip install --no-cache-dir runpod Pillow requests python-dotenv boto3 \
    "huggingface_hub>=0.34,<1.0"

# TRELLIS.2 is still needed: o-voxel (GLB export) lives in its tree.
RUN git clone -b main --depth 1 https://github.com/microsoft/TRELLIS.2.git /app/TRELLIS.2 && \
    rm -rf /app/TRELLIS.2/o-voxel/third_party/eigen && \
    git clone --depth 1 --branch 3.4.0 https://gitlab.com/libeigen/eigen.git \
      /app/TRELLIS.2/o-voxel/third_party/eigen

# Pixal3D itself: master is the TRELLIS.2-backbone version (there is no `main`).
ARG PIXAL3D_REF=master
RUN git clone -b ${PIXAL3D_REF} --depth 1 https://github.com/TencentARC/Pixal3D.git /app/Pixal3D

RUN pip install --no-cache-dir \
    imageio imageio-ffmpeg tqdm easydict opencv-python-headless ninja trimesh fast_simplification scipy scikit-image \
    "transformers>=4.45,<5" tensorboard pandas lpips zstandard \
    kornia timm plyfile filelock safetensors einops "triton>=3.2.0" \
    "diffusers>=0.31" accelerate && \
    pip install --no-cache-dir \
      git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8 && \
    pip install --no-cache-dir xformers==0.0.29.post3 \
      --index-url https://download.pytorch.org/whl/cu124

# MoGe-2 estimates the camera FOV that the pixel-aligned conditioning needs.
RUN pip install --no-cache-dir git+https://github.com/microsoft/MoGe.git

RUN git clone -b v0.4.0 --depth 1 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast && \
    pip install --no-cache-dir --no-build-isolation /tmp/nvdiffrast && \
    rm -rf /tmp/nvdiffrast

RUN git clone -b renderutils --depth 1 https://github.com/JeffreyXiang/nvdiffrec.git /tmp/nvdiffrec && \
    pip install --no-cache-dir --no-build-isolation /tmp/nvdiffrec && \
    rm -rf /tmp/nvdiffrec

RUN git clone --depth 1 https://github.com/JeffreyXiang/CuMesh.git /tmp/CuMesh && \
    rm -rf /tmp/CuMesh/third_party/cubvh && \
    git clone --depth 1 --branch trellis.2 https://github.com/JeffreyXiang/cubvh.git /tmp/CuMesh/third_party/cubvh && \
    rm -rf /tmp/CuMesh/third_party/cubvh/third_party/eigen && \
    git clone --depth 1 --branch 3.4.0 https://gitlab.com/libeigen/eigen.git \
      /tmp/CuMesh/third_party/cubvh/third_party/eigen && \
    pip install --no-cache-dir --no-build-isolation /tmp/CuMesh && \
    rm -rf /tmp/CuMesh

RUN git clone --depth 1 https://github.com/JeffreyXiang/FlexGEMM.git /tmp/FlexGEMM && \
    pip install --no-cache-dir --no-build-isolation /tmp/FlexGEMM && \
    rm -rf /tmp/FlexGEMM

RUN pip install --no-cache-dir --no-build-isolation --no-deps /app/TRELLIS.2/o-voxel

# MoGe and diffusers can drag huggingface_hub back to 1.x; re-pin last.
RUN pip install --no-cache-dir "huggingface_hub>=0.34,<1.0"

# NATTEN is a hard import of valeoai/NAF, which DinoV3ProjFeatureExtractor
# loads for the 2048-channel proj conditioner. Upstream pins 0.21.0; official
# wheels for that line are torch 2.7+, and the authors' own wheel is cp310.
# Compile only the GPUs this endpoint actually uses (4090/L40S=8.9, A6000/A40=8.6).
ENV NATTEN_CUDA_ARCH="8.6;8.9" \
    NATTEN_N_WORKERS=2
RUN pip install --no-cache-dir --no-build-isolation natten==0.21.0

COPY docker/smoke_pixal3d_imports.py /tmp/smoke_pixal3d_imports.py
# SMOKE_FATAL=0 lets a failing image still be pushed, so the import problem can
# be read from RunPod logs instead of costing another full CI build.
ARG SMOKE_FATAL=1
RUN python /tmp/smoke_pixal3d_imports.py || [ "${SMOKE_FATAL}" = "0" ]

ARG PARADOX_BUILD_SHA=dev
ENV PARADOX_BUILD_SHA=${PARADOX_BUILD_SHA}
ENV PARADOX_WORKER_VARIANT=pixal3d

COPY worker_pixal3d.py /app/worker_pixal3d.py
COPY runpod_billing.py /app/runpod_billing.py

CMD ["python", "-u", "/app/worker_pixal3d.py"]
