# MV-Adapter texture worker — mesh + reference image → textured GLB
#
# Upstream: https://github.com/huanngzh/MV-Adapter (Apache-2.0)
# Pipeline: SDXL + MV-Adapter multi-view → nvdiffrast UV bake → GLB
# VRAM: ~14–16 GB (SDXL); fits 4090 24 GB serverless.
#
# Build:
#   docker build -f Dockerfile.mvadapter -t paradox-mvadapter .
#
# Env at runtime (RunPod template):
#   R2_ENDPOINT_URL, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#   R2_PUBLIC_BASE_URL, RUNPOD_API_KEY

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9+PTX" \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/runpod-volume/huggingface_cache \
    TORCH_HOME=/runpod-volume/torch_cache \
    TORCH_EXTENSIONS_DIR=/runpod-volume/torch_extensions \
    OPEN3D_DISABLE_WEB_VISUALIZER=true \
    OPEN3D_CPU_RENDERING=true

WORKDIR /app

# ── system deps ──────────────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        ninja-build build-essential wget unzip \
        libgl1 libegl1 libglib2.0-0 libgomp1 libx11-6 libxi6 libxxf86vm1 \
        libxext6 libxrender1 libsm6 libglvnd0 && \
    rm -rf /var/lib/apt/lists/*

# ── pin torch 2.4.1+cu124 ───────────────────────────────────────────
# Retry-friendly: no --force-reinstall on first pin (CI flake on GH runners).
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu124
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        "torch==2.4.1+cu124" "torchvision==0.19.1+cu124" "torchaudio==2.4.1+cu124" \
        --index-url "${TORCH_INDEX}"

# ── diffusers stack (pinned — 0.39+ crashes on torch 2.4.1) ─────────
RUN pip install --no-cache-dir \
        "diffusers==0.31.0" \
        "transformers==4.46.3" \
        "accelerate==0.34.2" \
        "peft==0.13.2" \
        "huggingface_hub>=0.23,<1.0"

# ── clone MV-Adapter ────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/huanngzh/MV-Adapter.git /app/MV-Adapter

# ── texture runtime deps (curated; skip gradio/open3d/training stack) ─
COPY docker/mvadapter_texture_reqs.txt /tmp/mvadapter_texture_reqs.txt
RUN echo "torch==2.4.1+cu124" > /tmp/constraints.txt && \
    echo "torchvision==0.19.1+cu124" >> /tmp/constraints.txt && \
    echo "torchaudio==2.4.1+cu124" >> /tmp/constraints.txt && \
    PIP_CONSTRAINT=/tmp/constraints.txt \
        pip install --no-cache-dir -r /tmp/mvadapter_texture_reqs.txt

# ── re-pin torch (deps may have pulled a different version) ──────────
# Retry once: GH Actions occasionally flakes on large cu124 wheels.
RUN pip install --no-cache-dir --force-reinstall \
        "torch==2.4.1+cu124" "torchvision==0.19.1+cu124" "torchaudio==2.4.1+cu124" \
        --index-url "${TORCH_INDEX}" || \
    (sleep 15 && pip install --no-cache-dir --force-reinstall \
        "torch==2.4.1+cu124" "torchvision==0.19.1+cu124" "torchaudio==2.4.1+cu124" \
        --index-url "${TORCH_INDEX}")

# ── nvdiffrast (needs CUDA dev headers from base image) ──────────────
RUN pip install --no-cache-dir --no-build-isolation --ignore-installed \
        "git+https://github.com/NVlabs/nvdiffrast.git"

# ── CV-CUDA (texture uv_padding) ────────────────────────────────────
RUN pip install --no-cache-dir "cvcuda-cu12==0.16.0"

# ── extra texture helpers ────────────────────────────────────────────
# pymeshlab pin matches MV-Adapter Percentage API.
# matplotlib is imported by mvadapter.utils.saving.
# open3d --no-deps + patch: skip visualization import (dash/plotly) so CI
# stays lean while UV atlas / t.geometry still work for texture_i2tex.
# open3d-cpu: no CUDA .so at import (CI buildx has no libcuda). Still replace
# __init__ so visualization/ml (dash/plotly) are never imported.
COPY docker/patch_open3d_headless.py /tmp/patch_open3d_headless.py
COPY docker/open3d_headless_init.py /tmp/open3d_headless_init.py
RUN pip install --no-cache-dir \
        gltflib jaxtyping typeguard spandrel==0.4.1 opencv-python-headless \
        matplotlib && \
    pip install --no-cache-dir "pymeshlab==2022.2.post3" && \
    pip install --no-cache-dir --no-deps "open3d-cpu==0.18.0" && \
    python /tmp/patch_open3d_headless.py

# ── checkpoints (RealESRGAN + LaMa inpainter) ───────────────────────
RUN mkdir -p /app/MV-Adapter/checkpoints && \
    wget -q -O /app/MV-Adapter/checkpoints/RealESRGAN_x2plus.pth \
        https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth && \
    wget -q -O /app/MV-Adapter/checkpoints/big-lama.pt \
        https://github.com/Sanster/models/releases/download/add_big_lama/big-lama.pt

# ── runpod handler deps ─────────────────────────────────────────────
RUN pip install --no-cache-dir runpod boto3 Pillow requests trimesh xatlas

# ── build-time smoke (no GPU import on CI buildx) ───────────────────
COPY docker/smoke_mvadapter_imports.py /tmp/smoke_mvadapter_imports.py
RUN python -u /tmp/smoke_mvadapter_imports.py

# ── build metadata ──────────────────────────────────────────────────
ARG BUILD_SHA=dev
ENV PARADOX_BUILD_SHA=${BUILD_SHA}

COPY worker_mvadapter.py /app/worker_mvadapter.py
COPY docker/mvadapter_serverless_i2tex.py /app/MV-Adapter/scripts/mvadapter_serverless_i2tex.py

CMD ["python", "-u", "/app/worker_mvadapter.py"]
