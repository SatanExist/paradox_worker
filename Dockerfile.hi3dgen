# Hi3DGen — same hookup pattern as TRELLIS.2:
#   T2  = clone the demo repo (microsoft/TRELLIS.2) + thin RunPod wrapper
#   H0  = clone the demo Space (Stable-X/Hi3DGen) + thin RunPod wrapper
# Do NOT use GitHub Stable3DGen HEAD (BiRefNet + marching cubes; worse than the Space).
# Tags: ghcr.io/satanexist/paradox_worker:hi3dgen-sha-<short>
#
# Weights stay on the network volume (HF_HOME / HI3DGEN_WEIGHTS), not in the image.

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    SPCONV_ALGO=native \
    ATTN_BACKEND=sdpa \
    SPARSE_ATTN_BACKEND=xformers \
    HF_HOME=/runpod-volume/huggingface_cache \
    TORCH_HOME=/runpod-volume/torch_hub \
    U2NET_HOME=/runpod-volume/hi3dgen/u2net \
    HI3DGEN_REPO=/app/Hi3DGen \
    HI3DGEN_WEIGHTS=/runpod-volume/hi3dgen/weights \
    PYTHONPATH=/app:/app/Hi3DGen \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    GIT_LFS_SKIP_SMUDGE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
      runpod Pillow requests python-dotenv huggingface_hub boto3 \
      "diffusers==0.32.2" accelerate "transformers==4.46.3" \
      "kornia==0.8.0" "timm==1.0.14" easydict \
      tqdm scipy trimesh "numpy==1.26.4" scikit-image \
      opencv-python-headless einops safetensors \
      "rembg==2.0.60" "onnxruntime==1.20.1" \
      git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8

# Keep image torch; wheels must match cu124 (Space lists cu126 / torch 2.10 — same as T2: we don't chase demo torch).
RUN pip install --no-cache-dir xformers==0.0.27.post2 \
      --index-url https://download.pytorch.org/whl/cu124 || \
    pip install --no-cache-dir xformers==0.0.28.post1 \
      --index-url https://download.pytorch.org/whl/cu124

RUN pip install --no-cache-dir spconv-cu124==2.3.8

# Pin: Space HEAD we audited 2026-08-19 (rembg u2net + FlexiCubes). Bump deliberately.
ENV HI3DGEN_SPACE_SHA=e574b1154a712c8d587eef1e3a90f7adbc502898
RUN git clone --depth 1 https://huggingface.co/spaces/Stable-X/Hi3DGen /app/Hi3DGen && \
    test "$(git -C /app/Hi3DGen rev-parse HEAD)" = "$HI3DGEN_SPACE_SHA"

COPY docker/smoke_hi3dgen_imports.py /tmp/smoke_hi3dgen_imports.py
RUN python /tmp/smoke_hi3dgen_imports.py

ARG PARADOX_BUILD_SHA=dev
ENV PARADOX_BUILD_SHA=${PARADOX_BUILD_SHA}
ENV PARADOX_WORKER_VARIANT=hi3dgen

COPY worker_hi3dgen.py /app/worker_hi3dgen.py
COPY runpod_billing.py /app/runpod_billing.py
COPY scripts/hi3dgen_h0_infer.py /app/scripts/hi3dgen_h0_infer.py

WORKDIR /app/Hi3DGen
CMD ["python", "-u", "/app/worker_hi3dgen.py"]
