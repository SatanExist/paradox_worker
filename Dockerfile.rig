# syntax=docker/dockerfile:1
# Rig worker: GPU serverless on RunPod for the one GPU tool, auto_rig (tools_ops.auto_rig -> tools_rig/autorig.py).
# Same handler as the CPU tools worker (worker_tools.py); the lab sends auto_rig here (RUNPOD_ENDPOINT_ID_RIG).
# Tags: ghcr.io/satanexist/paradox_worker:rig-sha-<short>
#
# SkinTokens (VAST-AI, code + weights MIT) rigs any creature. Part of its code comes from Michelangelo (GPL-3.0):
# fine for running on our own server; the image itself must not be handed out without its source.
# Pinned to what was tested on the dev PC (RTX 5070 Ti): repo commit, weight revision, torch 2.7.0 + CUDA 12.8,
# the Python packages below, and SDPA attention instead of flash-attn (docker/skintokens_sdpa.patch, the same
# change as on the PC). Same model + switches on the same GPU type -> the same rig file.
# Weights (1.6 GB) are inside the image, pinned to their Hugging Face revision: no volume to set up, and a newer
# upload can never change the rigs quietly.
# The "doesn't look like a character" note (tools_rig/kind.py: SigLIP 2 + Blender pictures) is off here
# (no SIGLIP_DIR, no Blender): +1.5 GB and a GPU-less render to check first; the rig itself does not need it.
# Torch wheels carry their own CUDA runtime, so a plain Python base is enough (RunPod gives the driver).

# decode.mjs unpacks Draco / meshopt GLBs before the rig (same as the tools image)
FROM node:20-slim AS tools_node
WORKDIR /app/tools_node
COPY tools_node/package.json tools_node/package-lock.json ./
RUN npm ci --omit=dev
COPY tools_node/decode.mjs ./

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SKINTOKENS_DIR=/app/SkinTokens \
    RIG_PYTHON=/usr/local/bin/python \
    TOOLS_NODE_DIR=/app/tools_node \
    CUBLAS_WORKSPACE_CONFIG=:4096:8 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

# git for the clone; the rest are what bpy (Blender as a module) and open3d load at import time, headless
# (open3d's Linux wheel links libusb-1.0 for its RealSense support: without it `import open3d` fails)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1 \
    libegl1 \
    libglib2.0-0 \
    libgomp1 \
    libusb-1.0-0 \
    libx11-6 \
    libxrender1 \
    libxxf86vm1 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libsm6 \
    libice6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && \
    pip install "torch==2.7.0" "torchvision==0.22.0" --index-url https://download.pytorch.org/whl/cu128

# SkinTokens' requirements.txt at the versions tested on the PC, plus runpod/boto3 (handler, R2), libigl (bend
# judge, fused parts) and trimesh (tools_ops). Two differ from the PC on purpose: there gradio 6.32 + Pillow 13 sit
# next to huggingface_hub 0.36 only because they were installed one by one (gradio 6.21+ needs hub >= 1.16, which
# transformers 4.57 refuses). gradio 6.17.3 is the newest that takes hub 0.36, and it wants Pillow < 13. Neither is on
# the rig's path: gradio is only imported by demo.py for its web page, Pillow only draws judge pictures.
RUN pip install runpod requests boto3 \
    "numpy==1.26.4" "scipy==1.17.1" "transformers==4.57.1" "tokenizers==0.22.2" "diffusers==0.35.2" \
    "python-box==8.0.0" "einops==0.8.2" "omegaconf==2.4.0" "lightning==2.6.6" "addict==2.4.0" \
    "fast_simplification==0.2.0" "bpy==5.0.1" "trimesh==5.2.1" "open3d==0.20.0" "huggingface_hub==0.36.2" \
    "gradio==6.17.3" "bottle==0.13.4" "tornado==6.6.1" "safetensors==0.8.0" "pillow==12.3.0" "tqdm==4.70.1" \
    "PyYAML==6.0.3" "libigl==2.6.3"

# flash_attn's API on PyTorch SDPA, the same package the PC has (SkinTokens' skin VAE imports flash_attn)
COPY docker/flash_attn_sdpa /usr/local/lib/python3.11/site-packages/flash_attn

# The repo at the commit we tested, with the attention change (flash-attn 2 is not installed; SDPA, as on the PC)
# and the faster Blender mesh read + weight write (docker/skintokens_speed.patch: the same files byte for byte,
# checked on 42 models for the read and old/new files for the transfer; the Blender steps about 2x faster)
ENV SKINTOKENS_SHA=273b691d35989d71cd17ff2895fdc735097b92d1
COPY docker/skintokens_sdpa.patch docker/skintokens_speed.patch /tmp/
RUN git clone https://github.com/VAST-AI-Research/SkinTokens.git /app/SkinTokens && \
    git -C /app/SkinTokens checkout "$SKINTOKENS_SHA" && \
    git -C /app/SkinTokens apply --whitespace=nowarn /tmp/skintokens_sdpa.patch /tmp/skintokens_speed.patch && \
    grep -q 'attn_implementation="sdpa"' /app/SkinTokens/src/model/tokenrig.py && \
    grep -q '_triangle_faces' /app/SkinTokens/src/rig_package/parser/bpy.py

# Weights and the LLM config at the revisions we tested (same files download.py fetches)
RUN cd /app/SkinTokens && python - <<'EOF'
from huggingface_hub import hf_hub_download, snapshot_download
for name in ("experiments/skin_vae_2_10_32768/last.ckpt",
             "experiments/articulation_xl_quantization_256_token_4/grpo_1400.ckpt"):
    hf_hub_download("VAST-AI/SkinTokens", name, revision="79736cad0fd84de384d5eede659b4ebd24effe33", local_dir=".")
snapshot_download("Qwen/Qwen3-0.6B", revision="c1899de289a04d12100db370d81485cdf75e47ca",
                  local_dir="models/Qwen3-0.6B", ignore_patterns=["*.bin", "*.safetensors"])
EOF

COPY studio_bridge/__init__.py studio_bridge/mesh_repair.py studio_bridge/tools_ops.py studio_bridge/r2_public.py /app/studio_bridge/
COPY tools_rig /app/tools_rig
COPY worker_tools.py /app/worker_tools.py
COPY docker/smoke_rig_imports.py /tmp/smoke_rig_imports.py
COPY --from=tools_node /usr/local/bin/node /usr/local/bin/node
COPY --from=tools_node /app/tools_node /app/tools_node

RUN cd /app/SkinTokens && python /tmp/smoke_rig_imports.py

ARG PARADOX_BUILD_SHA=dev
ENV PARADOX_BUILD_SHA=${PARADOX_BUILD_SHA}
ENV PARADOX_WORKER_VARIANT=rig

CMD ["python", "-u", "/app/worker_tools.py"]
