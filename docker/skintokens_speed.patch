+def _triangle_faces(me, rot):
+    """extract_mesh's per-polygon loop, vectorised, for meshes made only of triangles with three different corners
+    (what glTF import gives); None for anything else, which then takes the loop. The loop walks a polygon's edges from
+    nodes[0], the first element of list(set(sorted(corners))) - CPython's set order, kept by building the same sets -
+    so a triangle (p, q, r) in loop order comes out as (p, q, r), (q, p, r) or (r, q, p) when nodes[0] is p, q or r.
+    Normals: rot @ polygon.normal, the same float32 matrix-vector product per face."""
+    n = len(me.polygons)
+    if n == 0:
+        return None
+    total = np.empty(n, np.int32)
+    me.polygons.foreach_get("loop_total", total)
+    if not (total == 3).all():
+        return None
+    start = np.empty(n, np.int32)
+    me.polygons.foreach_get("loop_start", start)
+    lv = np.empty(len(me.loops), np.int32)
+    me.loops.foreach_get("vertex_index", lv)
+    pqr = lv[start[:, None] + np.arange(3)].astype(np.int64)
+    if ((pqr[:, 0] == pqr[:, 1]) | (pqr[:, 1] == pqr[:, 2]) | (pqr[:, 0] == pqr[:, 2])).any():
+        return None
+    first = np.fromiter((next(iter(set(t))) for t in np.sort(pqr, axis=1).tolist()), np.int64, n)
+    p, q, r = pqr.T
+    faces = np.where((first == p)[:, None], pqr,
+                     np.where((first == q)[:, None], np.stack([q, p, r], 1), np.stack([r, q, p], 1)))
+    nrm = np.empty(n * 3, np.float32)
+    me.polygons.foreach_get("normal", nrm)
+    normals = np.matmul(rot, nrm.reshape(-1, 3, 1))[:, :, 0]  # float32 like rot @ polygon.normal
+    return faces, normals
+
