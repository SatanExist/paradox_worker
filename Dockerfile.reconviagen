# ReconViaGen v0.5 hybrid pipeline — CUDA 12.4 base, PyTorch 2.4 cu121 pins.
# Tags: ghcr.io/satanexist/paradox_worker:reconviagen-sha-<short>
#
# Lessons from D3 pod (do NOT repeat on raw pod):
# - huggingface_hub==1.7.2 (not 0.33.4) for transformers==5.3.0
# - o-voxel --no-deps (avoid torch override)
# - triton>=3.2 before flex_gemm (flex_gemm requires it; torch 2.4 bundles 3.0)
# - o-voxel path: wheels/TRELLIS.2/o-voxel (not repo root)

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/lib64 \
    MAX_JOBS=2 \
    PYOPENGL_PLATFORM=egl \
    RVG_REPO=/app/ReconViaGen \
    PYTHONPATH=/app/ReconViaGen:/app/ReconViaGen/wheels/TRELLIS.2 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    SPCONV_ALGO=native \
    XFORMERS_DISABLED=1 \
    HF_HOME=/runpod-volume/huggingface_cache \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9+PTX"

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
      torch==2.4.0 torchvision==0.19.0 \
      --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --no-cache-dir "triton>=3.2.0,<3.4.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    pkg-config \
    libjpeg-dev \
    libpng-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libglvnd0 \
    libgl1 \
    libglx0 \
    libegl1 \
    libgles2 \
    libglvnd-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir runpod Pillow requests python-dotenv huggingface_hub==1.7.2 boto3

# ReconViaGen v0.5 + submodules (wheels/TRELLIS.2, vggt, …).
RUN git clone --recursive -b v0.5 --depth 1 \
    https://github.com/GAP-LAB-CUHK-SZ/ReconViaGen.git /app/ReconViaGen && \
    ln -sfn wheels/TRELLIS.2/o-voxel /app/ReconViaGen/o-voxel

# o-voxel eigen (shallow clone breaks submodule init).
RUN rm -rf /app/ReconViaGen/wheels/TRELLIS.2/o-voxel/third_party/eigen && \
    git clone --depth 1 --branch 3.4.0 https://gitlab.com/libeigen/eigen.git \
      /app/ReconViaGen/wheels/TRELLIS.2/o-voxel/third_party/eigen

RUN pip install --no-cache-dir \
    imageio imageio-ffmpeg tqdm easydict opencv-python-headless scipy scikit-image ninja \
    rembg onnxruntime trimesh open3d xatlas pyvista pymeshfix igraph lpips \
    kornia==0.8.2 "transformers==5.3.0" zstandard pillow-simd rtree fast-simplification \
    einops safetensors filelock plyfile timm && \
    pip install --no-cache-dir \
      git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8 && \
    pip install --no-cache-dir xformers==0.0.27.post2 \
      --index-url https://download.pytorch.org/whl/cu121

RUN git clone -b v0.4.0 --depth 1 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast && \
    pip install --no-cache-dir --no-build-isolation /tmp/nvdiffrast && \
    rm -rf /tmp/nvdiffrast

RUN git clone -b renderutils --depth 1 https://github.com/JeffreyXiang/nvdiffrec.git /tmp/nvdiffrec && \
    pip install --no-cache-dir --no-build-isolation /tmp/nvdiffrec && \
    rm -rf /tmp/nvdiffrec

RUN git clone --depth 1 https://github.com/JeffreyXiang/CuMesh.git /tmp/CuMesh && \
    rm -rf /tmp/CuMesh/third_party/cubvh && \
    git clone --depth 1 --branch trellis.2 https://github.com/JeffreyXiang/cubvh.git /tmp/CuMesh/third_party/cubvh && \
    rm -rf /tmp/CuMesh/third_party/cubvh/third_party/eigen && \
    git clone --depth 1 --branch 3.4.0 https://gitlab.com/libeigen/eigen.git \
      /tmp/CuMesh/third_party/cubvh/third_party/eigen && \
    pip install --no-cache-dir --no-build-isolation /tmp/CuMesh && \
    rm -rf /tmp/CuMesh

RUN git clone --depth 1 https://github.com/JeffreyXiang/FlexGEMM.git /tmp/FlexGEMM && \
    pip install --no-cache-dir --no-build-isolation /tmp/FlexGEMM && \
    rm -rf /tmp/FlexGEMM

# Do not let o-voxel setup.py pull a different torch (D3 lesson).
RUN pip install --no-cache-dir --no-build-isolation --no-deps \
    /app/ReconViaGen/wheels/TRELLIS.2/o-voxel

RUN pip install --no-cache-dir spconv-cu120 && \
    pip install --no-cache-dir kaolin -f https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.4.0_cu121.html

# flash-attn: upstream wheel is cp310-only; build for py3.11 (slow layer, cached in CI).
RUN pip install --no-cache-dir --no-build-isolation flash-attn==2.7.0.post2

# mip-splatting rasterizer (ReconViaGen setup --mipgaussian).
RUN git clone --recurse-submodules --depth 1 \
    https://github.com/autonomousvision/mip-splatting.git /tmp/mip-splatting && \
    pip install --no-cache-dir --no-build-isolation \
      /tmp/mip-splatting/submodules/diff-gaussian-rasterization/ && \
    rm -rf /tmp/mip-splatting

# Re-pin torch stack after extension installs that may bump versions.
RUN pip install --no-cache-dir --force-reinstall \
      torch==2.4.0 torchvision==0.19.0 \
      --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --no-cache-dir "triton>=3.2.0,<3.4.0"

COPY docker/smoke_reconviagen_imports.py /tmp/smoke_reconviagen_imports.py
RUN python /tmp/smoke_reconviagen_imports.py

ARG PARADOX_BUILD_SHA=dev
ENV PARADOX_BUILD_SHA=${PARADOX_BUILD_SHA}
ENV PARADOX_WORKER_VARIANT=reconviagen

COPY worker_reconviagen.py /app/worker_reconviagen.py
COPY runpod_billing.py /app/runpod_billing.py
COPY scripts/reconviagen_infer.py /app/reconviagen_infer.py

CMD ["python", "-u", "/app/worker_reconviagen.py"]
